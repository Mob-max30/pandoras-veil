# Copy to .env and source it, or export these directly. All have working
# defaults (see internal/config/config.go) — this file is only needed to
# override them.

PANDORA_PORT=8080
PANDORA_REDIS_ADDR=localhost:6379
PANDORA_REDIS_PASSWORD=
PANDORA_REDIS_DB=0
PANDORA_DEFAULT_TTL_SECONDS=900
PANDORA_MAX_TTL_SECONDS=604800
PANDORA_MIN_TTL_SECONDS=30
PANDORA_MAX_CIPHERTEXT_BYTES=2097152
PANDORA_SHUTDOWN_GRACE_SECONDS=10
